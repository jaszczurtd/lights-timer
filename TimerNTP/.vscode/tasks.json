{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "boardSelection",
      "description": "Select an assembly of device_tree.json",
      "type": "pickString",
      "options": [
        "picow - rp2040/picow"
      ],
      "default": "picow - rp2040/picow"
    },
    {
      "id": "otaPassword",
      "description": "TimerNTP OTA password",
      "type": "promptString",
      "password": true
    }
  ],
  "tasks": [
    {
      "label": "Project: Build",
      "detail": "Compile TimerNTP through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "build",
        "--project",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Build (Debug)",
      "detail": "Debug build TimerNTP through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "build-debug",
        "--project",
        "${workspaceFolder}"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Upload",
      "detail": "Verified serial upload; falls back to UF2 when a BOOTSEL drive is visible",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "upload",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Upload (UF2 / BOOTSEL)",
      "detail": "Build TimerNTP and copy UF2 to the single visible BOOTSEL drive",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "upload-uf2",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Upload (OTA)",
      "detail": "Build, authenticate, and upload TimerNTP to the configured native RP device",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "upload-ota",
        "--project",
        "${workspaceFolder}",
        "--interactive"
      ],
      "options": {
        "env": {
          "TIMER_NTP_OTA_PASSWORD": "${input:otaPassword}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Discover OTA devices",
      "detail": "List JaszczurHAL devices advertising native OTA",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "ota-discover",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Serial Monitor",
      "detail": "Persistent TimerNTP serial monitor through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "monitor",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "replace-own"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Debug Probe Monitor",
      "detail": "Debug Probe monitor through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "monitor-probe",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "replace-own"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Serial Monitor (Any)",
      "detail": "Any serial monitor through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "monitor-any",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "wait"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Refresh IntelliSense",
      "detail": "Refresh TimerNTP IntelliSense through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "refresh-intellisense",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Clean",
      "detail": "Clean TimerNTP build directory through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "clean",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Clear USB Identity",
      "detail": "Flash neutral firmware after verifying the current Lights Timer identity",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "clear-identity",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Config Dump",
      "detail": "Show resolved JaszczurHAL VS Code configuration",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "config-dump",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: List ports",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "list-ports",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Change port",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "change-port",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Select board",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "select-board",
        "--project",
        "${workspaceFolder}",
        "--interactive"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Select board (GUI)",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "select-board",
        "--project",
        "${workspaceFolder}",
        "--selection",
        "${input:boardSelection}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Sync board picker",
      "detail": "Update the board-selection list and managed debug configurations.",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "sync-board-picker",
        "--project",
        "${workspaceFolder}"
      ],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Check device tree",
      "detail": "Check every assembly of device_tree.json after each save and list the problems at their place in the file.",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "check-hardware",
        "--project",
        "${workspaceFolder}",
        "--watch"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "jaszczurhal-device-tree",
        "source": "device_tree.json",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^jh-vscode check-hardware: checking ",
          "endsPattern": "^jh-vscode check-hardware: (no problems|\\d+ problems?)$"
        }
      }
    },
    {
      "label": "Project: Build (Debug) picow",
      "detail": "Build the picow assembly with debug settings for its debug profile.",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "build-debug",
        "--project",
        "${workspaceFolder}",
        "--assembly",
        "picow"
      ],
      "hide": true,
      "problemMatcher": "$gcc"
    }
  ]
}
