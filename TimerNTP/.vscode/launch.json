{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug picow (RP2040)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/.build/rp2040/picow/firmware.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug) picow",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        }
    ]
}
